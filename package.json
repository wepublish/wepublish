{
  "name": "wepublish",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.20.0"
  },
  "sideEffects": [
    "**/libs/utils/api/src/lib/sentry/instrumentation.ts"
  ],
  "scripts": {
    "migrate": "prisma migrate deploy && prisma db seed && pnpm run changelog:sync",
    "changelog:sync": "tsx -r dotenv/config libs/changelog/api/src/lib/sync/run-sync-changelogs.ts",
    "changelog:check": "tsx libs/changelog/api/src/lib/sync/run-check-changelog.ts",
    "changelog:create": "tsx libs/changelog/api/src/lib/sync/run-create-changelog.ts",
    "changelog:generate": "tsx libs/changelog/api/src/lib/sync/run-generate-changelog.ts",
    "serve": "nx run-many  --parallel 10 -t serve --output-style stream",
    "dev": "run-s start:docker watch",
    "clean": "run-p --print-label clean:**",
    "clean:media": "docker volume rm wepublish_storage",
    "lint": "nx run-many --target=lint",
    "build": "nx run-many --targets=build",
    "i18n": "node_modules/i18next-parser/bin/cli.js --config i18next-parser.config.js",
    "test": "nx run-many --target=test --parallel=false",
    "test-u": "nx run-many --target=test --parallel=false --configuration=update",
    "test-backend": "nx run-many --target=test --parallel=10 --exclude='*website*'",
    "test-website": "nx run-many --target=test --parallel=3 --projects=*website*",
    "e2e": "nx run e2e:e2e",
    "e2e:dev": "pnpm run start:docker && pnpm run e2e --dev --ui",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "watch:editor": "nx serve editor",
    "watch:api-example": "nx serve api-example",
    "watch:website-example": "nx serve website-example",
    "watch:media": "nx serve media",
    "start:docker": "docker-compose up --detach database storage dragonfly",
    "watch": "pnpm run migrate && nx run-many --target=serve --output-style=stream --projects=api-example,editor,media,website-example",
    "generate-api": "graphql-codegen -r dotenv/config --config codegen.yml",
    "try": "docker-compose up database migration api editor media storage dragonfly",
    "prettier": "prettier --write \"{apps,libs}/**/*.{js,ts,tsx,json}\"",
    "prepare": "prisma generate && husky",
    "deploy:production": "node deployment/deploy_production.js",
    "deploy:production:tags": "bash deployment/clean_deploy_tags.sh",
    "setup:production:local": "bash tools/setup-local-production-database.sh"
  },
  "nx": {
    "includedScripts": [
      "generate-api"
    ],
    "projectType": "library"
  },
