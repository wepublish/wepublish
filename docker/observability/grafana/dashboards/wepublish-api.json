      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "service_instance:reporting{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}} {{service_instance_id}}"
        }
      ]
    },
