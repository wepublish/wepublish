{
  "name": "@nestjs/platform-node",
  "version": "12.1.3-spike.0",
  "description": "Vendored build of the unreleased @nestjs/platform-node adapter (nestjs/nest#18063)",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "prepare": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./*.js": "./*.js",
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.js"
    }
  },
  "dependencies": {
    "content-type": "2.1.0",
    "cookie": "0.7.2",
    "cookie-signature": "1.2.2",
    "cors": "2.8.6",
    "encodeurl": "2.0.0",
    "fast-querystring": "1.1.2",
    "find-my-way": "9.9.0",
    "mime-types": "3.0.2",
    "multer": "2.4.0",
    "on-finished": "2.4.1",
    "path-to-regexp": "8.4.2",
    "qs": "6.15.3",
    "secure-json-parse": "4.1.0",
    "send": "1.2.1",
    "serve-static": "2.2.1",
    "tslib": "2.8.1",
    "type-is": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0"
  }
}
