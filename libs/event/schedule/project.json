{
  "name": "event-schedule",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/event/schedule/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/event/schedule",
        "tsConfig": "libs/event/schedule/tsconfig.lib.json",
        "main": "libs/event/schedule/src/index.ts",
        "rootDir": "."
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "options": {
        "config": "../../../{projectRoot}/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/event/schedule/tsconfig.spec.json"
      }
    }
  }
}
