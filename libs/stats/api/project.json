{
  "name": "stats-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/stats/api/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "typecheck": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/stats/api",
        "tsConfig": "libs/stats/api/tsconfig.lib.json",
        "main": "libs/stats/api/src/index.ts",
        "rootDir": "."
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/stats/api/jest.config.ts"
      }
    }
  }
}
