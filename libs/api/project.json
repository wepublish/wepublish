{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/src",
  "projectType": "library",
  "tags": ["publishable"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run --passWithNoTests --config {projectRoot}/vitest.config.ts"
      },
      "configurations": {
        "ci": {
          "command": "vitest run --passWithNoTests --coverage --config {projectRoot}/vitest.config.ts"
        },
        "update": {
          "command": "vitest run --passWithNoTests --update --config {projectRoot}/vitest.config.ts"
        }
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/api",
        "tsConfig": "libs/api/tsconfig.lib.json",
        "packageJson": "libs/api/package.json",
        "main": "libs/api/src/index.ts",
        "assets": ["libs/api/*.md", "libs/api/prisma/**/*"],
        "buildableProjectDepsInPackageJsonType": "dependencies",
        "rootDir": ".",
        "updateBuildableProjectDepsInPackageJson": true
      }
    }
  }
}
