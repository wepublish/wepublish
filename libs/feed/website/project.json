{
  "name": "feed-website",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/feed/website/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/feed/website",
        "tsConfig": "libs/feed/website/tsconfig.lib.json",
        "main": "libs/feed/website/src/index.ts",
        "rootDir": "."
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run --passWithNoTests --config {projectRoot}/vitest.config.ts"
      },
      "configurations": {
        "ci": {
          "command": "vitest run --passWithNoTests --coverage --config {projectRoot}/vitest.config.ts"
        },
        "update": {
          "command": "vitest run --passWithNoTests --update --config {projectRoot}/vitest.config.ts"
        }
      }
    }
  }
}
